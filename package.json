{
  "name": "patilife-app",
  "version": "1.0.0",
  "description": "PatiLife & Patile Oyna Mobile App",
  "main": "index.js",
  "scripts": {
    "build": "python3 scripts/stamp_web_revision.py && python3 scripts/build_mobile.py",
    "sync": "npx cap sync",
    "open:ios": "npx cap open ios",
    "build:check": "python3 scripts/stamp_web_revision.py --check && python3 scripts/build_mobile.py --check",
    "build:web": "python3 scripts/stamp_web_revision.py && python3 scripts/build_mobile.py --web-only",
    "test": "node --test tests/*.test.cjs && python3 -m unittest discover -s tests -p test_*.py",
    "open:android": "npx cap open android",
    "postinstall": "node scripts/patch-admob-consent.cjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
